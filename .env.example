# Secret de signature des JWT de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Facultatif — chemin de la base SQLite (défaut : ./data/app.db).
# Utile en production pour pointer vers un disque persistant.
# DATABASE_PATH=./data/app.db

# OBSOLÈTE — le compte unique n'existe plus.
#
# Les comptes vivent dans la table `users` : créez-en un depuis /register.
# Ces deux variables ne servent plus qu'à promouvoir le compte de transfert
# créé par la migration multi-utilisateur, afin que les données déjà saisies
# restent accessibles. Si elles sont absentes, ce compte ne peut pas servir
# à se connecter et les données qu'il porte deviennent inaccessibles.
#
# Email du compte de transfert (celui qui détient les données existantes).
AUTH_USER_EMAIL=

# Hash bcrypt du mot de passe. Générer avec :
#   node -e "console.log(require('bcryptjs').hashSync('mon-mot-de-passe', 10))"
#
# ATTENTION : les antislashs sont obligatoires. @next/env utilise dotenv-expand,
# qui interprète chaque `$NOM` comme une variable d'environnement et la remplace
# par une chaîne vide. Un hash bcrypt non échappé arrive donc VIDE dans le
# processus et `bcrypt.compare` échoue toujours, même avec le bon mot de passe.
# Chaque `$` du hash doit être écrit `\$`.
AUTH_USER_PASSWORD_HASH=
